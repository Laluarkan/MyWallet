# Neon PostgreSQL Connection URL
# Ambil connection string dari Neon Dashboard (postgresql://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=5000
NODE_ENV=development
